# Copy this file to .env and fill in real values. Never commit .env itself.

DATABASE_URL=postgresql://compliance_user:compliance_pass@localhost:5432/compliance_db

# Generate a real one for anything beyond local dev: `openssl rand -hex 32`
JWT_SECRET=dev-only-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

MAX_UPLOAD_MB=10
UPLOAD_DIR=./uploads

# Left blank on purpose. The AI track wires this up; without it the
# assist endpoint returns its stub response so the rest of the app
# still works end to end.
LLM_API_KEY=

RESEND_API_KEY=
FROM_ADDRESS=onboarding@resend.dev
FRONTEND_BASE_URL=http://localhost:5173
